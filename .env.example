# Environment variables example for production
# Copy this file to .env and fill values before deploying

# Django
SECRET_KEY=replace-with-a-strong-secret-key
DEBUG=False
ALLOWED_HOSTS=yourusername.pythonanywhere.com

# DeepL (optional)
DEEPL_API_KEY=

# Database (optional) - if using PostgreSQL on production
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# Any other env variables used by your setup
# For example, if you use external storage or email settings
